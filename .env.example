# ──────────────────────────────────────────────
# EdStem Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Never put real keys in this file; it is meant to be committed.
# ──────────────────────────────────────────────

# EdStem credentials (leave empty to run without the live listener)
ED_API_TOKEN=
ED_COURSE_ID=0
ED_BASE_URL=https://us.edstem.org

# LLM Provider — choose one: openai | gemini | claude
LLM_PROVIDER=openai

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Database (SQLite — no setup needed, just a local file)
DATABASE_URL=sqlite+aiosqlite:///./edstembot.db

# ChromaDB vector store directory
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=course_materials

# Sentence-transformers embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chrome extension: shared secret (any long random string); paste the same value in the extension options
EXTENSION_SECRET=

# askEd Live (public audience Q&A + quiz). Leave these alone for local use.
# APP_MODE=live mounts ONLY the audience and presenter routes (use this on Render).
APP_MODE=full
# sentence-transformers (default, heavy) | fastembed (light, for small hosts)
EMBEDDING_BACKEND=sentence-transformers
# Public https URL encoded in the QR code, e.g. https://asked-live.onrender.com
PUBLIC_BASE_URL=
# Secret for /present, /live/stats and /live/reset (any long random string)
PRESENTER_KEY=
# Quiz answers needed before a topic is ranked on the reveal page
LIVE_MIN_ATTEMPTS=5
# Max audience questions answered per day (bounds LLM spend)
LIVE_DAILY_ASK_CAP=500

# Dashboard server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
