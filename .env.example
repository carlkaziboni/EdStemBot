# ──────────────────────────────────────────────
# EdStem Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Never put real keys in this file; it is meant to be committed.
# ──────────────────────────────────────────────

# EdStem credentials (leave empty to run without the live listener)
ED_API_TOKEN=
ED_COURSE_ID=0
ED_BASE_URL=https://us.edstem.org

# LLM Provider — choose one: openai | gemini | claude
LLM_PROVIDER=openai

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Database (SQLite — no setup needed, just a local file)
DATABASE_URL=sqlite+aiosqlite:///./edstembot.db

# ChromaDB vector store directory
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=course_materials

# Sentence-transformers embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chrome extension: shared secret (any long random string); paste the same value in the extension options
EXTENSION_SECRET=

# Dashboard server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
